# 後端 apps/server .env 範本
# 使用方式：cp .env.example .env 後填入實際值。
# 用途：本機（非 Docker）執行 pnpm db:push / pnpm test / pnpm dev:server 時讀取。
# 後端跑在 Docker 時，這些值改由 docker-compose 提供（見根目錄 .env），不看此檔。

# 連線字串：本機從 host 連 DB，用 localhost:5432（非 db:5432）。
# 密碼須與根目錄 .env 的 POSTGRES_PASSWORD 一致，否則連不上。
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/fastify_drizzle_todolist

# （選填）測試庫連線字串。留空時，跑 pnpm test 會自動把上面的 DATABASE_URL
# 資料庫名稱換成 <name>_test（即 fastify_drizzle_todolist_test），測試只在該庫上
# TRUNCATE，不會清空開發庫。只有連到「非預設 host 的測試庫」時才需要明確設定。
# 首次或 schema 變更後，用 pnpm db:push:test 把 schema 推到測試庫。
# 安全防呆：測試庫名稱必須以 _test 結尾，否則測試會直接中止。
# TEST_DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/fastify_drizzle_todolist_test

# 允許的前端來源（vite dev 預設 5173）。
CORS_ORIGIN=http://localhost:5173

# JWT 簽章密鑰，建議與根目錄 .env 的 JWT_SECRET 相同，讓 Docker 與本機 token 通用。
JWT_SECRET=replace-with-openssl-rand-hex-32

# （選填）本機執行 server 時的監聽埠；預設 3000。若想跟 Docker 對齊可設 7529。
# PORT=7529
