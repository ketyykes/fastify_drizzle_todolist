{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "seed": "tsx src/scripts/seed-dev-user.ts",
    "outbox:requeue-dead": "tsx src/scripts/outbox-requeue-dead.ts",
    "outbox:prune": "tsx src/scripts/outbox-prune.ts",
    "staging-sync:run": "tsx src/scripts/staging-sync-run.ts",
    "staging-sync:status": "tsx src/scripts/staging-sync-status.ts",
    "staging-sync:abandon": "tsx src/scripts/staging-sync-abandon.ts",
    "staging-sync:prune": "tsx src/scripts/staging-sync-prune.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify_drizzle_todolist/db": "workspace:*",
    "@fastify_drizzle_todolist/env": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fastify_drizzle_todolist/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
