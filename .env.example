# 根目錄 .env 範本
# Docker Compose 讀取此檔的變數做 ${...} 代換。
# 使用方式：cp .env.example .env 後填入實際值（.env 已被 gitignore，不會進版控）。

# JWT 簽章密鑰。產生強隨機值：openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Postgres 密碼（會代入 docker-compose 的 db 與 server 連線字串）。
# 建議 URL-safe（純英數）：openssl rand -hex 16
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Transactional outbox（見 docs/outbox/design.md） ---

# outbox sweeper 送出訊息的目標端點（mock 外部 webhook 服務）。
OUTBOX_WEBHOOK_URL=http://localhost:7529/mock-external/notifications

# worker 輪詢 sweeper 的間隔（毫秒）。
OUTBOX_SWEEP_INTERVAL_MS=60000

# 送出單筆 outbox 訊息的 HTTP 逾時（毫秒）。
OUTBOX_SEND_TIMEOUT_MS=10000

# --- Seed 測試帳號（選填，僅供本機測試，正式環境務必覆寫或移除） ---

# seed 腳本建立的固定測試帳號 email。
# SEED_USER_EMAIL=dev@example.com

# seed 腳本建立的固定測試帳號密碼（明文，至少 8 碼；建立時會以 bcrypt 雜湊儲存）。
# SEED_USER_PASSWORD=dev12345
